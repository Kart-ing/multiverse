#!/usr/bin/env bash
set -e

# Multiverse - AI-powered development tool with parallel decision tree exploration
# Resolve symlink to find the actual project root
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || greadlink -f "$0" 2>/dev/null || python3 -c "import os; print(os.path.realpath('$0'))" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# Source .env if it exists
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a; source "$SCRIPT_DIR/.env"; set +a
fi

echo "┌──────────────────────────────────────┐"
echo "│         🔀  MULTIVERSE  🔀           │"
echo "│  Decision Tree Agent Mode            │"
echo "│  Explore 5 paths. Pick the winner.   │"
echo "└──────────────────────────────────────┘"
echo ""

exec bun run --cwd "$SCRIPT_DIR/packages/opencode" --conditions=browser src/index.ts "$@"

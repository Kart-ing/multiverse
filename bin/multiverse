#!/usr/bin/env bash
set -e

# Multiverse - AI-powered development tool with parallel decision tree exploration

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MULTIVERSE_HOME="${MULTIVERSE_HOME:-$SCRIPT_DIR}"

# Source .env if it exists
if [ -f "$MULTIVERSE_HOME/.env" ]; then
  export $(grep -v '^#' "$MULTIVERSE_HOME/.env" | xargs)
fi

echo "┌──────────────────────────────────────┐"
echo "│         🔀  MULTIVERSE  🔀           │"
echo "│  Decision Tree Agent Mode            │"
echo "│  Explore 5 paths. Pick the winner.   │"
echo "└──────────────────────────────────────┘"
echo ""

exec bun run --cwd "$MULTIVERSE_HOME/packages/opencode" --conditions=browser src/index.ts "$@"
